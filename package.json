{
  "name": "@jrmoulckers/engineering",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for Engineering-owned shared configuration packages.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "principles:index": "node scripts/build-principles-index.mjs",
    "principles:check": "node scripts/build-principles-index.mjs --check",
    "citations:check": "node scripts/check-citations.mjs . --index principles/index.json",
    "citations:review": "node scripts/check-citations.mjs . --index principles/index.json --review",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage:check": "node scripts/check-coverage.mjs",
    "versions:check": "node scripts/check-published-versions.mjs",
    "pins:check": "node scripts/check-pins.mjs",
    "coverage:list": "node scripts/check-coverage.mjs --list",
    "versions:print": "node scripts/print-versions.mjs",
    "release:check": "node scripts/check-release-lag.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint": "^9.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^2.46.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.1.0",
    "typescript": "^5.6.3"
  },
  "prettier": "./packages/prettier-config/index.js"
}
