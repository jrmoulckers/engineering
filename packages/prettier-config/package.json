{
  "name": "@jrmoulckers/prettier-config",
  "version": "0.4.0",
  "description": "Engineering-owned Prettier configuration.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrmoulckers/engineering.git",
    "directory": "packages/prettier-config"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./svelte": {
      "types": "./svelte.d.ts",
      "default": "./svelte.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "svelte.js",
    "svelte.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.2.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "prettier-plugin-svelte": {
      "optional": true
    }
  }
}
